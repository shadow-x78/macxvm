# ─────────────────────────────────────────────
# MacXVM - Editor Configuration
# https://github.com/shadow-x78/macxvm
# ─────────────────────────────────────────────

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
